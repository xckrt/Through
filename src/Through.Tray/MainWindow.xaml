<Window x:Class="Through.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Through.Tray"
        Title="{local:Tr 'Сквозь'}" Width="1100" Height="780" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen" Icon="through.ico"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource Body}" FontSize="14" UseLayoutRounding="True">

    <Window.Resources>

        <!-- карточка обзора и цвет состояния по Tag (OrbState) -->
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="26,26,28,24" />
        </Style>
        <Style x:Key="OrbStatus" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On"><Setter Property="Foreground" Value="{DynamicResource Pine}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Busy"><Setter Property="Foreground" Value="{DynamicResource Amber}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Problem"><Setter Property="Foreground" Value="{DynamicResource Signal}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayNarrow}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="VerdictText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Style.Triggers>
                <!-- целая зелёная тропа говорит «работает» сама, слово в каждой строке лишнее -->
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Throttled">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Minor">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource Pine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Blocked">
                    <Setter Property="Foreground" Value="{DynamicResource Signal}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Slow">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Partial">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TargetRow" DataType="{x:Type local:TargetVm}">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource NameColumn}" />
                    <ColumnDefinition Width="{StaticResource TrailColumn}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource MetricColumn}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <local:TrailView Grid.Column="1" State="{Binding State}" StopAt="{Binding StopAt}" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding Verdict}" />
                <TextBlock Grid.Column="2" Text="{Binding Verdict}" Style="{StaticResource VerdictText}"
                           Margin="20,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Metric}" Foreground="{DynamicResource InkSoft}"
                           FontFamily="{StaticResource DisplayNarrow}" Typography.NumeralAlignment="Tabular"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ServiceBlock" DataType="{x:Type local:ServiceVm}">
            <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource RowToggle}"
                              AutomationProperties.Name="{Binding Title}"
                              AutomationProperties.HelpText="{Binding Summary}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource NameColumn}" />
                            <ColumnDefinition Width="{StaticResource TrailColumn}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource MetricColumn}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="21"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource SummaryText}"
                                   Margin="20,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="Chevron" Grid.Column="3" Text="&#xE70D;" FontFamily="{StaticResource Icons}"
                                   FontSize="12" Foreground="{DynamicResource InkSoft}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                </ToggleButton>

                <ItemsControl ItemsSource="{Binding Targets}" ItemTemplate="{StaticResource TargetRow}" Focusable="False" />

                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}" Margin="0,10,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource NameColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding PlanHeading}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding HasPlanHeading, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding PlanItems}" Focusable="False" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Rectangle Width="10" Height="2.5" Fill="{DynamicResource Pine}" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Technical}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource InkSoft}" FontSize="12"
                                                 TextWrapping="Wrap" Padding="0" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,14,0,14" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <!-- своя рамка: заголовок Сквозь вместо системного, края окна по-прежнему тянутся -->
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" Background="{DynamicResource Paper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======== заголовок: метка, вкладки, состояние защиты, кнопки окна ======== -->
            <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="24,0,34,0" VerticalAlignment="Center">
                        <Border BorderBrush="{DynamicResource Ink}" BorderThickness="1" CornerRadius="1.5" Width="13" Height="17">
                            <UniformGrid Rows="3">
                                <Rectangle Fill="White" />
                                <Rectangle x:Name="BrandStripe" Fill="{DynamicResource Signal}" />
                                <Rectangle Fill="White" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="{local:Tr 'Сквозь'}" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold"
                                   Margin="10,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize" ToolTip="{local:Tr 'Свернуть'}" />
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="ToggleMaximize" ToolTip="{local:Tr 'Развернуть'}" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseClicked" ToolTip="{local:Tr 'Закрыть'}" />
                    </StackPanel>

                    <!-- плашка: состояние защиты видно с любой страницы -->
                    <Border DockPanel.Dock="Right" x:Name="PillBorder" CornerRadius="11" Padding="11,3,13,4" Margin="0,0,18,0"
                            VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Paper}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Fog}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pill}" Value="On"><Setter Property="Fill" Value="{DynamicResource Pine}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Pill}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Signal}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Pill}" Value="Busy"><Setter Property="Fill" Value="{DynamicResource Amber}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding PillText}" FontFamily="{StaticResource DisplayNarrow}" FontSize="13"
                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <RadioButton Style="{StaticResource NavTab}" Content="{local:Tr 'Обзор'}" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Overview}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Overview" />
                        <RadioButton Style="{StaticResource NavTab}" Content="{local:Tr 'Приложения'}" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Apps}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Apps" />
                        <RadioButton Style="{StaticResource NavTab}" Content="Telegram" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Telegram}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Telegram" />
                        <RadioButton Style="{StaticResource NavTab}" Content="{local:Tr 'Журнал'}" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Log}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Log" />
                        <RadioButton Style="{StaticResource NavTab}" Content="{local:Tr 'Настройки'}" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ======== полоса уведомлений: новая версия или «в прошлый раз Сквозь упала» ======== -->
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                    Padding="48,10" Visibility="{Binding HasBanner, Converter={StaticResource Visible}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{local:Tr 'Что нового'}" Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" Margin="0,0,8,0"
                                Command="{Binding ReleaseNotesCommand}" Visibility="{Binding BannerIsUpdate, Converter={StaticResource Visible}}" />
                        <Button Content="{local:Tr 'Позже'}" Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" Margin="0,0,8,0"
                                Command="{Binding BannerLaterCommand}" />
                        <Button Content="{Binding BannerAction}" Style="{StaticResource PrimaryButton}" Padding="16,6" FontSize="13"
                                Command="{Binding BannerPrimaryCommand}" />
                    </StackPanel>
                    <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource Pine}" Margin="0,2,12,2" />
                    <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" Margin="0,0,16,0" />
                </DockPanel>
            </Border>

            <!-- ======== Обзор: две большие кнопки — обход и Telegram ======== -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Overview}">
                <StackPanel Margin="48,28,48,26">
                    <StackPanel x:Name="HomeHead">
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource Soft}" FontSize="15.5" />
                        <TextBlock Text="{Binding HomeHeadline}" FontFamily="{StaticResource Display}" FontSize="38" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,20" />
                    </StackPanel>

                    <!-- строка-дашборд: короткие живые показатели одним взглядом -->
                    <Grid x:Name="HomeStats" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HomeCard}" Padding="18,12,18,13">
                            <StackPanel>
                                <TextBlock Text="{local:Tr 'ЗАЩИТА'}" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding ZapretStatus}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ZapretOrb}" Value="On"><Setter Property="Foreground" Value="{DynamicResource Go}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ZapretOrb}" Value="Problem"><Setter Property="Foreground" Value="{DynamicResource Signal}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ZapretOrb}" Value="Busy"><Setter Property="Foreground" Value="{DynamicResource Amber}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource HomeCard}" Padding="18,12,18,13">
                            <StackPanel>
                                <TextBlock Text="{local:Tr 'СЕРВИСЫ'}" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding ServicesStat}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ink}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource HomeCard}" Padding="18,12,18,13">
                            <StackPanel>
                                <TextBlock Text="{local:Tr 'СКОРОСТЬ'}" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding SpeedStat}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Pine}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- фирменная сцена «прорыв сквозь стену»: поток идёт сквозь, когда обход включён -->
                    <Border x:Name="HomeHero" Style="{StaticResource HomeCard}" Padding="0" Margin="0,0,0,18" ClipToBounds="True">
                        <local:BreakthroughView Height="172"
                                                On="{Binding ZapretOrb, Converter={StaticResource Is}, ConverterParameter=On}" />
                    </Border>

                    <!-- умная подсказка: нужная функция в нужный момент -->
                    <Border x:Name="HomeHintCard" Style="{StaticResource HomeCard}" Padding="22,16,16,16" Margin="0,0,0,18"
                            Visibility="{Binding HasHint, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9"
                                    Style="{StaticResource QuietButton}" Padding="8,6" ToolTip="{local:Tr 'Скрыть'}" Command="{Binding DismissHintCommand}" />
                            <StackPanel>
                                <TextBlock Text="{Binding HintText}" Style="{StaticResource Soft}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
                                <Button Content="{Binding HintAction}" Command="{Binding ApplyHintCommand}" Style="{StaticResource QuietButton}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ZapretCard" Style="{StaticResource HomeCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <local:PowerOrb Diameter="148" State="{Binding ZapretOrb}" Command="{Binding ZapretToggleCommand}"
                                                VerticalAlignment="Top" Margin="-8,-8,0,0"
                                                AutomationProperties.Name="{local:Tr 'Включить или выключить обход блокировок'}"
                                                ToolTip="{local:Tr 'Включить или выключить обход блокировок'}" />
                                <StackPanel Grid.Column="1" Margin="18,10,0,0">
                                    <TextBlock Text="{local:Tr 'ОБХОД БЛОКИРОВОК'}" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding ZapretStatus}" Tag="{Binding ZapretOrb}" Style="{StaticResource OrbStatus}" />
                                    <TextBlock Text="{Binding ZapretDetail}" Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                    <TextBlock Text="{Binding SpeedText}" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Pine}" Margin="0,0,0,8"
                                               Visibility="{Binding HasSpeed, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding ZapretNetwork}" Style="{StaticResource Soft}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Visibility="{Binding HasZapretNetwork, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding HomeServices}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ServiceVm}">
                                                <Border CornerRadius="14" Padding="12,6,14,6" Margin="0,0,8,8" Background="{DynamicResource Paper}"
                                                        BorderBrush="{DynamicResource Line}" BorderThickness="1" ToolTip="{Binding Summary}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="9" Height="9" Margin="0,1,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource Fog}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Health}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Pine}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Health}" Value="Partial"><Setter Property="Fill" Value="{DynamicResource Pine}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Health}" Value="Slow"><Setter Property="Fill" Value="{DynamicResource Amber}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Health}" Value="Blocked"><Setter Property="Fill" Value="{DynamicResource Signal}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel>
                                        <Button Content="{local:Tr 'Подобрать заново'}" Command="{Binding TuneCommand}" Style="{StaticResource QuietButton}"
                                                HorizontalAlignment="Left" Padding="14,6" FontSize="13" Margin="0,8,8,0"
                                                Visibility="{Binding CanRetune, Converter={StaticResource Visible}}" />
                                        <Button Content="{local:Tr 'Замерить скорость YouTube'}" Command="{Binding MeasureSpeedCommand}" Style="{StaticResource QuietButton}"
                                                HorizontalAlignment="Left" Padding="14,6" FontSize="13" Margin="0,8,8,0"
                                                Visibility="{Binding HasService, Converter={StaticResource Visible}}" />
                                        <Button Content="{local:Tr 'Подобрать голос'}" Command="{Binding TuneVoiceCommand}" Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left" Padding="14,6" FontSize="13" Margin="0,8,8,0"
                                                Visibility="{Binding VoiceBroken, Converter={StaticResource Visible}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="TgCard" Grid.Column="2" Style="{StaticResource HomeCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <local:PowerOrb Diameter="148" State="{Binding TgOrb}" Command="{Binding TgToggleCommand}"
                                                VerticalAlignment="Top" Margin="-8,-8,0,0"
                                                AutomationProperties.Name="{local:Tr 'Включить или выключить прокси Telegram'}"
                                                ToolTip="{local:Tr 'Включить или выключить прокси Telegram'}" />
                                <StackPanel Grid.Column="1" Margin="18,10,0,0">
                                    <TextBlock Text="TELEGRAM" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding TgStatus}" Tag="{Binding TgOrb}" Style="{StaticResource OrbStatus}" />
                                    <TextBlock Text="{Binding TgDetail}" Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Button Content="{local:Tr 'Подключить в Telegram'}" Command="{Binding TgPrimaryCommand}" Style="{StaticResource QuietButton}"
                                            Padding="14,6" FontSize="13" Margin="0,0,8,8"
                                            Visibility="{Binding TgConnectVisible, Converter={StaticResource Visible}}" />
                                    <Button Content="{local:Tr 'Дата-центры и счётчики'}" Command="{Binding NavigateCommand}" CommandParameter="Telegram"
                                            Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" Margin="0,0,8,8" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>


                    <!-- защищённый DNS: тихий третий переключатель -->
                    <Border x:Name="DnsCard" Style="{StaticResource HomeCard}" Padding="26,18,26,18" Margin="0,22,0,0">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"
                                          IsChecked="{Binding DnsOn, Mode=OneWay}" Command="{Binding DnsToggleCommand}"
                                          AutomationProperties.Name="{local:Tr 'Защищённый DNS'}" />
                            <StackPanel>
                                <TextBlock Text="{local:Tr 'ЗАЩИЩЁННЫЙ DNS'}" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding DnsText}" Style="{StaticResource Soft}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- для всего дома: телефоны и ТВ через этот компьютер -->
                    <Border x:Name="HomeCard" Style="{StaticResource HomeCard}" Padding="26,18,26,18" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"
                                              IsChecked="{Binding HomeOn, Mode=OneWay}" Command="{Binding HomeToggleCommand}"
                                              AutomationProperties.Name="{local:Tr 'Обход для всего дома'}" />
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'ДЛЯ ВСЕГО ДОМА'}" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding HomeText}" Style="{StaticResource Soft}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding HasHomePac, Converter={StaticResource Visible}}">
                                <Border CornerRadius="12" Background="White" Padding="5" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <Image Source="{Binding HomeQr}" Width="132" Height="132" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <StackPanel Margin="18,2,0,0" MaxWidth="640">
                                    <TextBlock Text="{Binding HomePac}" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="{local:Tr 'Наведите телефон с Сквозь на QR: она скопирует адрес и откроет настройки Wi-Fi, останется вставить и выбрать «Авто». Вручную: Wi-Fi → эта сеть → Прокси → Авто, вставьте адрес. На iPhone и ТВ впишите адрес сами.'}" />
                                    <TextBlock Style="{StaticResource Soft}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="{local:Tr 'Работает, пока компьютер включён и Сквозь запущена. Чужие из интернета подключиться не могут: пускаются только устройства из этой сети.'}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding WeekText}" Style="{StaticResource Soft}" FontSize="13.5" Margin="4,16,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasWeek, Converter={StaticResource Visible}}" />
                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,28,0,22" />
                    <StackPanel>
                    <!-- «Почему не открывается?»: любой сайт по тем же этапам, вердикт и обход одной кнопкой -->
                    <DockPanel Margin="0,20,0,0" Width="760" HorizontalAlignment="Left">
                        <Button DockPanel.Dock="Right" Content="{local:Tr 'Проверить'}" Style="{StaticResource QuietButton}"
                                Command="{Binding CheckSiteCommand}" Margin="10,0,0,0" Padding="20,8" />
                        <Grid>
                            <TextBox x:Name="SiteBox" Text="{Binding SiteInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" FontSize="15" Padding="10,6"
                                     AutomationProperties.Name="{local:Tr 'Адрес сайта для проверки'}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CheckSiteCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{local:Tr 'Почему не открывается? Вставьте адрес сайта, например rutracker.org'}"
                                       Foreground="{DynamicResource Fog}" FontSize="15" Margin="17,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SiteInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <Border Margin="0,12,0,0" Padding="16,12,16,14" CornerRadius="4" MaxWidth="1100" HorizontalAlignment="Left"
                            Background="{DynamicResource Surface}"
                            Visibility="{Binding HasSiteResult, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource NameColumn}" />
                                    <ColumnDefinition Width="{StaticResource TrailColumn}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SiteRow.Host}" FontFamily="{StaticResource Display}" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                <local:TrailView Grid.Column="1" State="{Binding SiteRow.State}" StopAt="{Binding SiteRow.StopAt}"
                                                 VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SiteHeadline}" FontFamily="{StaticResource Display}" FontSize="15"
                                           Margin="20,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="3" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10"
                                        Style="{StaticResource QuietButton}" Padding="9,7" ToolTip="{local:Tr 'Закрыть'}"
                                        Command="{Binding CloseSiteCommand}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding SiteExplain}" Style="{StaticResource Soft}" Margin="0,10,0,0" MaxWidth="760"
                                       HorizontalAlignment="Left" />
                            <Button Content="{Binding SiteBypassLabel}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding BypassSiteCommand}" Margin="0,12,0,0"
                                    Visibility="{Binding SiteCanBypass, Converter={StaticResource Visible}}" />
                            <Button Content="{Binding SiteExcludeLabel}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                                    Command="{Binding SiteExcludeCommand}" Margin="0,10,0,0" Padding="14,6" FontSize="13"
                                    ToolTip="{local:Tr 'Если сайт сломался именно после включения обхода: обход перестанет его трогать'}"
                                    Visibility="{Binding HasSiteResult, Converter={StaticResource Visible}}" />
                            <Button Content="{local:Tr 'Включить защищённый DNS'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding FixSiteDnsCommand}" Margin="0,12,0,0"
                                    Visibility="{Binding SiteCanFixDns, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <DockPanel Margin="0,26,0,0">
                        <Button DockPanel.Dock="Right" Content="{local:Tr 'Подробная проверка'}" Command="{Binding OpenDiagnosticsCommand}"
                                Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" />
                        <Button DockPanel.Dock="Right" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}"
                                Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding CheckedAt}" Foreground="{DynamicResource InkSoft}" FontSize="12.5" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ======== Диагностика: проверка по этапам (раньше была обзором) ======== -->
            <Grid x:Name="DiagnosticsPage" Grid.Row="2" Margin="48,26,48,26" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Diagnostics}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Button Content="{local:Tr '← Обзор'}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="14,6" FontSize="13"
                            Margin="0,0,0,16" Command="{Binding NavigateCommand}" CommandParameter="Overview" />
                    <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource Display}" FontSize="36" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Subline}" FontSize="15.5" Foreground="{DynamicResource InkSoft}"
                               TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" LineHeight="23" />

                </StackPanel>

                <!-- Подписи этапов стоят ровно над отметками троп -->
                <Grid Grid.Row="1" Margin="0,28,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource NameColumn}" />
                        <ColumnDefinition Width="{StaticResource TrailColumn}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <UniformGrid Grid.Column="1" Columns="5" TextElement.Foreground="{DynamicResource InkSoft}"
                                 TextElement.FontFamily="{StaticResource DisplayNarrow}" TextElement.FontSize="12.5">
                        <TextBlock Text="DNS" HorizontalAlignment="Center" ToolTip="{local:Tr 'Поиск адреса сайта'}" />
                        <TextBlock Text="TCP" HorizontalAlignment="Center" ToolTip="{local:Tr 'Подключение к серверу'}" />
                        <TextBlock Text="TLS" HorizontalAlignment="Center" ToolTip="{local:Tr 'Защищённое соединение: здесь DPI видит имя сайта'}" />
                        <TextBlock Text="HTTP" HorizontalAlignment="Center" ToolTip="{local:Tr 'Запрос и ответ сервера'}" />
                        <TextBlock Text="{local:Tr 'передача'}" HorizontalAlignment="Center" ToolTip="{local:Tr 'Загрузка данных'}" />
                    </UniformGrid>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="10,0" Margin="-10,0">
                    <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ServiceBlock}" Focusable="False" />
                </ScrollViewer>

                <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="True">
                    <!-- без службы главная кнопка «Проверить», со службой — «Подобрать обход» -->
                    <Button DockPanel.Dock="Right" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Visibility="{Binding CheckIsPrimary, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}"
                            Style="{StaticResource QuietButton}"
                            Visibility="{Binding TuneVisible, Converter={StaticResource Visible}}" />
                    <!-- «Подобрать обход» зелёная, только когда что-то сломано; когда всё работает, она спокойная -->
                    <Button DockPanel.Dock="Right" Content="{local:Tr 'Подобрать обход'}" Command="{Binding TuneCommand}" Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Visibility="{Binding TuneIsPrimary, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="{local:Tr 'Подобрать обход'}" Command="{Binding TuneCommand}" Margin="0,0,10,0"
                            Style="{StaticResource QuietButton}"
                            Visibility="{Binding TuneIsSecondary, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="{Binding ProtectLabel}" Command="{Binding ProtectCommand}" Margin="0,0,10,0"
                            Style="{StaticResource QuietButton}"
                            Visibility="{Binding ProtectVisible, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Margin="0,0,10,0"
                            Style="{StaticResource QuietButton}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CheckedAt}" Foreground="{DynamicResource InkSoft}" FontSize="12.5" />
                        <TextBlock Text="{Binding ModeNote}" Foreground="{DynamicResource InkSoft}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,2,16,0"
                                   Visibility="{Binding HasModeNote, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- ======== Приложения ======== -->
            <Grid x:Name="AppsPage" Grid.Row="2" Margin="48,26,48,26" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Apps}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,22">
                    <TextBlock Text="{local:Tr 'Приложения'}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Soft}" FontSize="15" MaxWidth="700" HorizontalAlignment="Left" Margin="0,6,0,0"
                               Text="{local:Tr 'Сквозь обходит блокировки для этих сервисов. Если игра или сайт работает плохо, добавьте его: Сквозь подберёт стратегию и будет держать её.'}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding AppRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AppRowVm}">
                                <Border Style="{StaticResource HomeCard}" Padding="22,16,22,16" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{local:Tr 'Удалить'}" Style="{StaticResource QuietButton}" Padding="14,6"
                                                FontSize="13" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Key}"
                                                Visibility="{Binding IsUser, Converter={StaticResource Visible}}" />
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource SummaryText}" Margin="16,3,0,0" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource InkSoft}" FontSize="13" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- «не трогать»: сайты, которые обход ломает -->
                    <Border Style="{StaticResource HomeCard}" Padding="24,18,24,20" Margin="0,2,0,0">
                    <StackPanel>
                        <TextBlock Text="{local:Tr 'Не трогать'}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="{local:Tr 'Если после включения обхода перестал открываться банк, госуслуги или рабочий портал, добавьте его сюда: обход не будет трогать этот сайт и его поддомены.'}" />
                        <ItemsControl ItemsSource="{Binding ExcludedSites}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="14" Padding="12,4,6,4" Margin="0,0,8,8" Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="13.5" />
                                            <Button Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" Style="{StaticResource QuietButton}"
                                                    Padding="6,4" Margin="8,0,0,0" BorderThickness="0" ToolTip="{local:Tr 'Убрать из списка'}"
                                                    Command="{Binding DataContext.RemoveExcludeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="{local:Tr 'Не трогать'}" Command="{Binding AddExcludeCommand}"
                                    Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" Margin="8,0,0,0" />
                            <TextBox Text="{Binding ExcludeInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Width="360"
                                     AutomationProperties.Name="{local:Tr 'Адрес сайта, который обход не должен трогать'}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddExcludeCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- правая колонка: заготовки или форма -->
                <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <!-- запущенная программа: служба слушает её полминуты и заполняет форму -->
                        <StackPanel Visibility="{Binding PickerVisible, Converter={StaticResource Visible}}" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10"
                                        Style="{StaticResource QuietButton}" Padding="9,7" ToolTip="{local:Tr 'Закрыть'}" Command="{Binding ClosePickerCommand}" />
                                <TextBlock Text="{local:Tr 'Запущенные программы'}" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <TextBlock Text="{Binding ObserveText}" Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding NotObserving}">
                                <TextBlock Text="{local:Tr 'Слушать:'}" Style="{StaticResource Soft}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <RadioButton Style="{StaticResource Segment}" Content="{local:Tr '30 с'}" GroupName="ObsTime"
                                             IsChecked="{Binding ObserveSeconds, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=30}"
                                             Command="{Binding SetObserveTimeCommand}" CommandParameter="30" />
                                <RadioButton Style="{StaticResource Segment}" Content="{local:Tr '1 мин'}" GroupName="ObsTime"
                                             IsChecked="{Binding ObserveSeconds, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=60}"
                                             Command="{Binding SetObserveTimeCommand}" CommandParameter="60" />
                                <RadioButton Style="{StaticResource Segment}" Content="{local:Tr '2 мин'}" GroupName="ObsTime"
                                             IsChecked="{Binding ObserveSeconds, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=120}"
                                             Command="{Binding SetObserveTimeCommand}" CommandParameter="120" />
                                <RadioButton Style="{StaticResource Segment}" Content="{local:Tr '5 мин'}" GroupName="ObsTime"
                                             IsChecked="{Binding ObserveSeconds, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=300}"
                                             Command="{Binding SetObserveTimeCommand}" CommandParameter="300" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12" Foreground="{DynamicResource Pine}"
                                         Background="Transparent" BorderThickness="0"
                                         Visibility="{Binding Observing, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding RunningApps}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:RunningAppVm}">
                                        <Button Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="12,8"
                                                Command="{Binding DataContext.ObserveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,12,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="14.5" />
                                                    <TextBlock Text="{Binding Process}" Foreground="{DynamicResource InkSoft}" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding FormVisible, Converter={StaticResource IsVisible}, ConverterParameter=False}">
                            <TextBlock Text="{local:Tr 'Добавить'}" Style="{StaticResource SectionTitle}" />
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="16,11" Margin="0,0,0,8" Command="{Binding OpenPickerCommand}"
                                    Visibility="{Binding PickerVisible, Converter={StaticResource IsVisible}, ConverterParameter=False}">
                                <TextBlock Text="{local:Tr 'Выбрать запущенную программу'}" />
                            </Button>
                            <TextBlock Style="{StaticResource Soft}" Margin="0,4,0,14"
                                       Text="{local:Tr 'Сквозь сама подслушает, куда ходит игра, и соберёт домены и порты. Или начните с заготовки:'}" />
                            <ItemsControl ItemsSource="{Binding Templates}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AppTemplate}">
                                        <Button Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                                                Padding="16,11" FontSize="15"
                                                Command="{Binding DataContext.UseTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Name}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding FormVisible, Converter={StaticResource Visible}}">
                            <TextBlock Text="{local:Tr 'Новое приложение'}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FormNote}" Style="{StaticResource Soft}" />

                            <TextBlock Text="{local:Tr 'Название'}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />

                            <TextBlock Text="{local:Tr 'Домены, по одному в строке (поддомены обходятся сами)'}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FormDomains, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     AcceptsReturn="True" Height="118" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

                            <TextBlock Text="{local:Tr 'Хосты для проверки (если пусто, первые домены)'}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FormCheck, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr 'Игровые UDP-порты'}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding FormUdp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{local:Tr 'Игровые TCP-порты'}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding FormTcp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Soft}" FontSize="12.5" Margin="0,6,0,0"
                                       Text="{local:Tr 'Например 7777 или 27000-27100. Обход на этих портах действует для любого адреса, поэтому не указывайте лишнего.'}" />

                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding FormAlways}" Margin="0,16,0,0">
                                <TextBlock TextWrapping="Wrap" Text="{local:Tr 'Обходить всегда, даже если проверка проходит (для игр, которые тормозят, а не отваливаются)'}" />
                            </ToggleButton>

                            <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource Signal}" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding HasFormError, Converter={StaticResource Visible}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="{local:Tr 'Добавить и подобрать'}" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitAppCommand}" />
                                <Button Content="{local:Tr 'Отмена'}" Style="{StaticResource QuietButton}" Command="{Binding CancelFormCommand}" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======== Telegram: локальный прокси службы ======== -->
            <Grid x:Name="TelegramPage" Grid.Row="2" Margin="48,26,48,26" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Telegram}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,26">
                    <TextBlock Text="Telegram" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Soft}" FontSize="15" MaxWidth="720" HorizontalAlignment="Left" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{local:Tr 'Сквозь держит для Telegram локальный прокси: трафик уходит через WebSocket веб-версии Telegram, который режут реже, а если и его нет — через Cloudflare. Работает внутри службы, окно можно закрыть.'}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,4,14,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Fog}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TgHealth}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Pine}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding TgHealth}" Value="Partial"><Setter Property="Fill" Value="{DynamicResource Amber}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding TgHealth}" Value="Blocked"><Setter Property="Fill" Value="{DynamicResource Signal}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding TgHeadline}" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding TgSubline}" FontSize="15.5" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource InkSoft}" Margin="28,0,0,22" />

                        <WrapPanel Margin="28,0,0,18">
                            <Button Content="{Binding TgPrimaryLabel}" Command="{Binding TgPrimaryCommand}" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,10,10" />
                            <Button Content="{local:Tr 'Проверить дата-центры'}" Command="{Binding TgCheckCommand}" Style="{StaticResource QuietButton}"
                                    Margin="0,0,10,10" Visibility="{Binding TgOn, Converter={StaticResource Visible}}" />
                            <Button Content="{local:Tr 'Скопировать ссылку'}" Command="{Binding TgCopyCommand}" Style="{StaticResource QuietButton}"
                                    Margin="0,0,10,10" Visibility="{Binding TgOn, Converter={StaticResource Visible}}" />
                        </WrapPanel>

                        <Border Margin="28,0,0,18" Padding="16,12" CornerRadius="10" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Left" MaxWidth="640"
                                Visibility="{Binding HasTgRival, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{local:Tr 'Закрыть его'}" Command="{Binding TgCloseRivalCommand}"
                                        Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <TextBlock Text="{Binding TgRival}" TextWrapping="Wrap" FontSize="13.5" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <StackPanel Margin="28,6,0,0" Visibility="{Binding TgOn, Converter={StaticResource Visible}}">
                            <TextBlock Text="{local:Tr 'Как это устроено'}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Run Text="{local:Tr 'Адрес прокси: '}" /><Run Text="{Binding TgAddress, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" /><Run Text="{local:Tr '. Telegram шифрует всё сам, Сквозь лишь перекладывает его пакеты в WebSocket и не видит переписку.'}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,18"
                                       Text="{local:Tr 'Чтобы Telegram снова ходил напрямую, отключите прокси в его настройках.'}" />
                            <TextBlock Text="{local:Tr 'Телефон'}" Style="{StaticResource SectionTitle}" />
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding TgLanOn, Mode=OneWay}" Command="{Binding TgLanCommand}" Margin="0,0,0,12">
                                <TextBlock TextWrapping="Wrap" MaxWidth="560"
                                           Text="{local:Tr 'Пускать телефоны из этой Wi-Fi сети: Сквозь откроет прокси для устройств из вашей сети (из интернета к нему не попасть). Без секрета из QR-кода к нему не подключиться.'}" />
                            </ToggleButton>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" Visibility="{Binding HasTgQr, Converter={StaticResource Visible}}">
                                <Border CornerRadius="14" Background="White" Padding="6" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <Image Source="{Binding TgQr}" Width="190" Height="190" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <StackPanel Margin="20,6,0,0" MaxWidth="330">
                                    <TextBlock Text="{local:Tr 'Наведите камеру телефона'}" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="{local:Tr 'Ссылка откроется в Telegram, он спросит «Подключить прокси?». Работает, пока телефон в этой же Wi-Fi сети и компьютер включён.'}" />
                                    <TextBlock Text="{Binding TgLanLink}" Style="{StaticResource Soft}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="{local:Tr 'Выключить прокси'}" Command="{Binding TgOffCommand}" Style="{StaticResource QuietButton}"
                                    Foreground="{DynamicResource Signal}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- правая колонка: дата-центры и счётчики -->
                <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Border Style="{StaticResource HomeCard}" Padding="24,20,24,22" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{local:Tr 'Дата-центры'}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding DcRows}" Focusable="False" Margin="0,0,0,22">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DcRowVm}">
                                    <StackPanel>
                                        <DockPanel Margin="0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource SummaryText}" FontSize="14" />
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Width="52" />
                                            <TextBlock Text="{Binding Place}" Foreground="{DynamicResource InkSoft}" FontSize="13.5" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Rectangle Height="1" Fill="{DynamicResource Line}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding HasTgStats, Converter={StaticResource Visible}}">
                            <TextBlock Text="{local:Tr 'Что идёт через прокси'}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding TgStats}" Style="{StaticResource Soft}" LineHeight="22" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Soft}" FontSize="12.5" Margin="0,22,0,0" TextWrapping="Wrap"
                                   Text="{local:Tr 'Порт tg-ws-proxy от Flowseal (MIT), переписан на C# и работает в службе Сквозь без Python.'}" />
                    </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- ======== Журнал ======== -->
            <Grid x:Name="LogPage" Grid.Row="2" Margin="48,26,48,26" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Log}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="{local:Tr 'Открыть журнал службы'}" Style="{StaticResource QuietButton}"
                            Command="{Binding OpenServiceLogCommand}" VerticalAlignment="Top" />
                    <Button DockPanel.Dock="Right" Content="{local:Tr 'Сообщить о проблеме'}" Style="{StaticResource QuietButton}"
                            Command="{Binding ReportProblemCommand}" VerticalAlignment="Top" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{local:Tr 'Журнал'}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Soft}" FontSize="15" Margin="0,6,0,0"
                                   Text="{local:Tr 'Что Сквозь делала с момента открытия окна: попытки подбора, перезапуски, обновления.'}" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource HomeCard}" Padding="26,20,18,18">
                <Grid>
                <TextBlock Style="{StaticResource Soft}" Text="{local:Tr 'Пока тихо. События появятся, когда служба что-нибудь сделает.'}"
                           Visibility="{Binding LogLines.Count, Converter={StaticResource WhenEmpty}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding LogLines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LogLine}">
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="70" Foreground="{DynamicResource InkSoft}"
                                               FontFamily="{StaticResource DisplayNarrow}" Typography.NumeralAlignment="Tabular" />
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" Padding="0" FontSize="14">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Signal}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
                </Border>
            </Grid>

            <!-- ======== Настройки ======== -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Settings}">
                <StackPanel Margin="48,26,48,26" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{local:Tr 'Настройки'}" Style="{StaticResource PageTitle}" Margin="0,0,0,20" />

                    <Border Style="{StaticResource HomeCard}" Padding="26,22,26,24" Margin="0,0,0,16">
                    <StackPanel>
                    <TextBlock Text="{local:Tr 'Защита'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Soft}" Text="{Binding ModeNote}" Margin="0,0,0,12"
                               Visibility="{Binding HasModeNote, Converter={StaticResource Visible}}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding ProtectLabel}" Command="{Binding ProtectCommand}" Style="{StaticResource QuietButton}"
                                Visibility="{Binding ProtectVisible, Converter={StaticResource Visible}}" Margin="0,0,10,0" />
                        <Button Content="{local:Tr 'Подобрать обход заново'}" Command="{Binding TuneCommand}" Style="{StaticResource QuietButton}" />
                    </StackPanel>
                    </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HomeCard}" Padding="26,22,26,24" Margin="0,0,0,16">
                    <StackPanel>
                    <TextBlock Text="{local:Tr 'Игры и голос'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="{local:Tr 'Игровой фильтр накрывает обходом широкий диапазон UDP-портов, которые используют игры и голосовые чаты. Включите, если тормозят или не соединяются онлайн-игры или голос в Discord — тогда не нужно добавлять каждую игру отдельно. Задевает больше UDP-трафика, поэтому по умолчанию выключен; если что-то из сети начнёт глючить, выключите.'}" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GameFilter}" IsEnabled="{Binding HasService}">
                        <TextBlock TextWrapping="Wrap" Text="{local:Tr 'Игровой фильтр: обход для UDP-портов игр и голоса'}" />
                    </ToggleButton>
                    <!-- выбор игровой стратегии: ручной и авто-подбор по очереди -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasGameVariants, Converter={StaticResource Visible}}">
                        <StackPanel Visibility="{Binding GameAutoActive, Converter={StaticResource IsVisible}, ConverterParameter=False}">
                            <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="{local:Tr 'Стратегия. Если игра всё равно не соединяется или лагает, попробуйте другой вариант — у разных провайдеров работает разный.'}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{local:Tr 'Вариант 1'}" GroupName="GameVar"
                                             IsChecked="{Binding GameFilterVariant, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=0}"
                                             Command="{Binding SetGameVariantCommand}" CommandParameter="0" />
                                <RadioButton Style="{StaticResource Segment}" Content="{local:Tr 'Вариант 2'}" GroupName="GameVar"
                                             IsChecked="{Binding GameFilterVariant, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=1}"
                                             Command="{Binding SetGameVariantCommand}" CommandParameter="1" />
                                <RadioButton Style="{StaticResource Segment}" Content="{local:Tr 'Вариант 3'}" GroupName="GameVar"
                                             IsChecked="{Binding GameFilterVariant, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=2}"
                                             Command="{Binding SetGameVariantCommand}" CommandParameter="2" />
                            </StackPanel>
                            <Button Content="{local:Tr 'Подобрать для игры автоматически'}" Command="{Binding StartGameAutoCommand}"
                                    Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding HasGameAutoResult, Converter={StaticResource Visible}}" Text="{Binding GameAutoResult}" />
                        </StackPanel>
                        <!-- мастер: Сквозь включает варианты по очереди -->
                        <StackPanel Visibility="{Binding GameAutoActive, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,0,0,10" Text="{Binding GameAutoText}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{local:Tr 'Работает'}" Command="{Binding GameAutoWorksCommand}" Style="{StaticResource QuietButton}" Margin="0,0,10,0" />
                                <Button Content="{local:Tr 'Не работает — дальше'}" Command="{Binding GameAutoNextCommand}" Style="{StaticResource QuietButton}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HomeCard}" Padding="26,22,26,24" Margin="0,0,0,16">
                    <StackPanel>
                    <TextBlock Text="{local:Tr 'Обновления Сквозь'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="15" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding AppUpdateText}" Style="{StaticResource Soft}" Margin="0,0,0,14" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CheckAppUpdates}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap"
                                   Text="{local:Tr 'Проверять новые версии Сквозь на github.com/xckrt/Through и предлагать обновиться (сама Сквозь без спроса не обновляется)'}" />
                    </ToggleButton>
                    <Button Content="{local:Tr 'Проверить сейчас'}" Command="{Binding CheckAppUpdateCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HomeCard}" Padding="26,22,26,24" Margin="0,0,0,16">
                    <StackPanel>
                    <TextBlock Text="{local:Tr 'Обновления zapret'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding EngineText}" FontSize="15" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Soft}" Margin="0,0,0,14" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding HasService}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap"
                                   Text="{local:Tr 'Обновлять автоматически: раз в сутки Сквозь ищет новый релиз bol-van/zapret, сверяет хеши и переходит на него, а если он не запустится, возвращается к прежнему'}" />
                    </ToggleButton>
                    <Button Content="{local:Tr 'Проверить сейчас'}" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HomeCard}" Padding="26,22,26,24" Margin="0,0,0,16"
                            Visibility="{Binding HasCommunity, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr 'Общая база стратегий'}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="{local:Tr 'Сквозь делятся тем, что помогло: у вашего провайдера YouTube уже чинили — Сквозь попробует эту стратегию первой, и подбор займёт секунды. Провайдера сервер узнаёт сам по соединению; Сквозь отправляет только «сервис → стратегия → помогла или нет», без IP, адресов сайтов и идентификаторов.'}" />
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CommunityUse}" IsEnabled="{Binding HasService}" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap" Text="{local:Tr 'Брать подсказки из общей базы и обновлять списки сайтов для обхода'}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CommunityShare}" IsEnabled="{Binding HasService}">
                            <TextBlock TextWrapping="Wrap" Text="{local:Tr 'Делиться итогами своего подбора (помогает другим с тем же провайдером)'}" />
                        </ToggleButton>
                    </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HomeCard}" Padding="26,22,26,24" Margin="0,0,0,16">
                    <StackPanel>
                    <TextBlock Text="{local:Tr 'Окно'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{local:Tr 'Тема'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <RadioButton Style="{StaticResource Segment}" Content="{local:Tr 'Как в Windows'}" GroupName="Theme"
                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=System}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="System" />
                        <RadioButton Style="{StaticResource Segment}" Content="{local:Tr 'Светлая'}" GroupName="Theme"
                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Light}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                        <RadioButton Style="{StaticResource Segment}" Content="{local:Tr 'Тёмная'}" GroupName="Theme"
                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Dark}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    </StackPanel>
                    <TextBlock Text="Язык / Language" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <RadioButton Style="{StaticResource Segment}" Content="{local:Tr 'Как в Windows'}" GroupName="Lang"
                                     IsChecked="{Binding Language, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=System}"
                                     Command="{Binding SetLanguageCommand}" CommandParameter="System" />
                        <RadioButton Style="{StaticResource Segment}" Content="Русский" GroupName="Lang"
                                     IsChecked="{Binding Language, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Russian}"
                                     Command="{Binding SetLanguageCommand}" CommandParameter="Russian" />
                        <RadioButton Style="{StaticResource Segment}" Content="English" GroupName="Lang"
                                     IsChecked="{Binding Language, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=English}"
                                     Command="{Binding SetLanguageCommand}" CommandParameter="English" />
                    </StackPanel>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Autostart}" Margin="0,0,0,14"
                                  Visibility="{Binding NotPortable, Converter={StaticResource Visible}}">
                        <TextBlock TextWrapping="Wrap" Text="{local:Tr 'Запускать Сквозь вместе с Windows (сразу в трей)'}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Notify}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap" Text="{local:Tr 'Уведомлять, когда служба сама что-то сделала: подобрала заново, обновила zapret, не смогла включить защиту'}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}">
                        <TextBlock TextWrapping="Wrap" Text="{local:Tr 'Закрывать в трей: защиту держит служба, окно можно открыть значком у часов'}" />
                    </ToggleButton>
                    </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HomeCard}" Padding="26,22,26,24" Margin="0,0,0,16">
                    <StackPanel>
                    <TextBlock Text="{local:Tr 'О программе'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding BuildText}" Style="{StaticResource Soft}" />
                    <TextBlock Style="{StaticResource Soft}" Margin="0,4,0,14"
                               Text="{local:Tr 'Движок: zapret от bol-van, стратегии и шаблоны Flowseal/zapret-discord-youtube (MIT).'}" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShareCrashes}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap" MaxWidth="640"
                                   Text="{local:Tr 'Отправлять сводки об ошибках: тип ошибки и имена методов Сквозь, версии Сквозь и Windows. Без текста ошибок, путей, адресов сайтов и имён — помогает чинить то, что ломается у многих.'}" />
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{local:Tr 'Сообщить о проблеме'}" Command="{Binding ReportProblemCommand}" Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Left" Margin="0,0,10,0" />
                        <Button Content="{local:Tr 'Сохранить диагностику в файл'}" Command="{Binding SaveDiagnosticsCommand}" Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Soft}" FontSize="12.5" Margin="0,0,0,14"
                               Text="{local:Tr 'Откроется черновик issue на GitHub с версиями и журналами — или сохраните тот же отчёт в файл и пришлите его любым способом. Вы увидите весь текст; без вашего нажатия Сквозь ничего никуда не шлёт.'}" />
                    <Button Content="{local:Tr 'Удалить службу Сквозь'}" Command="{Binding UninstallServiceCommand}" Style="{StaticResource QuietButton}"
                            Foreground="{DynamicResource Signal}" HorizontalAlignment="Left"
                            Visibility="{Binding CanUninstall, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
