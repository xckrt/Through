<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- «Сквозь», светлая: фиалково-тёплый нейтрал, индиго — бренд и «работает», коралл — сигнал -->
    <SolidColorBrush x:Key="Paper" Color="#F1EEFB" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Field" Color="#F7F5FF" />
    <SolidColorBrush x:Key="Chrome" Color="#ECE8FF" />
    <SolidColorBrush x:Key="Ink" Color="#17142B" />
    <SolidColorBrush x:Key="InkSoft" Color="#6A6590" />
    <SolidColorBrush x:Key="Line" Color="#E4DEF7" />
    <SolidColorBrush x:Key="Fog" Color="#B3ABD6" />
    <SolidColorBrush x:Key="Pine" Color="#4B37F5" />
    <SolidColorBrush x:Key="PineDark" Color="#3A28D6" />
    <SolidColorBrush x:Key="Go" Color="#10C488" />
    <SolidColorBrush x:Key="Signal" Color="#FF5230" />
    <SolidColorBrush x:Key="Amber" Color="#C57B10" />
    <!-- текст на индиго-кнопке и бегунок переключателя -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Knob" Color="#FFFFFF" />
</ResourceDictionary>
