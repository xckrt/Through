<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- «Сквозь», тёмная: глубокий фиалково-чёрный, индиго светлее для читаемости, коралл — сигнал -->
    <SolidColorBrush x:Key="Paper" Color="#110F1C" />
    <SolidColorBrush x:Key="Surface" Color="#1A1729" />
    <SolidColorBrush x:Key="Field" Color="#221E36" />
    <SolidColorBrush x:Key="Chrome" Color="#0D0B15" />
    <SolidColorBrush x:Key="Ink" Color="#F3F0FF" />
    <SolidColorBrush x:Key="InkSoft" Color="#9A93BE" />
    <SolidColorBrush x:Key="Line" Color="#2C2743" />
    <SolidColorBrush x:Key="Fog" Color="#4A4468" />
    <SolidColorBrush x:Key="Pine" Color="#8977FF" />
    <SolidColorBrush x:Key="PineDark" Color="#6E5CF0" />
    <SolidColorBrush x:Key="Go" Color="#2BE3A6" />
    <SolidColorBrush x:Key="Signal" Color="#FF6F50" />
    <SolidColorBrush x:Key="Amber" Color="#E3A53C" />
    <SolidColorBrush x:Key="OnAccent" Color="#140F26" />
    <SolidColorBrush x:Key="Knob" Color="#F3F0FF" />
</ResourceDictionary>
