<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 встроен в Windows 10 (1903+) и 11: установщику не нужно тащить свой .NET,
       и он весит почти столько же, сколько сама программа внутри него -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Tropa.Setup</AssemblyName>
    <RootNamespace>Tropa.Setup</RootNamespace>
    <!-- только 64-битный процесс: 32-битному Windows подсунет Program Files (x86) -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- установщику нужны права администратора: служба, Program Files, «Приложения и возможности» -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Tropa.Tray\tropa.ico</ApplicationIcon>
    <!-- payload.zip — опубликованные окно и служба; кладёт его build/publish.ps1 -->
    <PayloadPath Condition="'$(PayloadPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\payload.zip</PayloadPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="payload.zip" Condition="Exists('$(PayloadPath)')" />
    <Resource Include="..\Tropa.Tray\tropa.ico" Link="tropa.ico" />
  </ItemGroup>

</Project>
