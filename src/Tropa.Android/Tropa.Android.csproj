<Project Sdk="Microsoft.NET.Sdk">
  <!-- Тропа для Android: прокси Telegram на телефоне, проверка того, что режут в мобильной сети, связка с компьютером.
       Общий код — Tropa.Core (тот же прокси, пробник и общая база). Собирается отдельно: нужен workload android. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tropa.Droid</RootNamespace>
    <AssemblyName>Tropa.Android</AssemblyName>
    <ApplicationId>com.xckrt.tropa</ApplicationId>
    <ApplicationTitle>Тропа</ApplicationTitle>
    <!-- versionCode растёт с версией: 1.2.0 → 10200 -->
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Major), 10000)), $([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Minor), 100)), $([System.Version]::Parse('$(Version)').Build)))))</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- Core сериализует отчёты через отражение: его не обрезаем -->
    <TrimMode>partial</TrimMode>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Tropa.Core" RootMode="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tropa.Core\Tropa.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\Tropa.Cli\targets.json" Link="Assets\targets.json" />
    <AndroidAsset Include="..\Tropa.Cli\community.json" Link="Assets\community.json" />
  </ItemGroup>

  <!-- подпись релиза: ключ из секрета CI (TROPA_KEYSTORE...), без него — отладочная подпись -->
  <PropertyGroup Condition="'$(TROPA_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(TROPA_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(TROPA_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>env:TROPA_KEY_PASS</AndroidSigningKeyPass>
    <AndroidSigningStorePass>env:TROPA_KEY_PASS</AndroidSigningStorePass>
  </PropertyGroup>
</Project>
