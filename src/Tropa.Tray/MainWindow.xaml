<Window x:Class="Tropa.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tropa.Tray"
        Title="Тропа" Width="1100" Height="780" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen" Icon="tropa.ico"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource Body}" FontSize="14" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="VerdictText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Style.Triggers>
                <!-- целая зелёная тропа говорит «работает» сама, слово в каждой строке лишнее -->
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Throttled">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Minor">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource Pine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Blocked">
                    <Setter Property="Foreground" Value="{DynamicResource Signal}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Slow">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Partial">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TargetRow" DataType="{x:Type local:TargetVm}">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource NameColumn}" />
                    <ColumnDefinition Width="{StaticResource TrailColumn}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource MetricColumn}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <local:TrailView Grid.Column="1" State="{Binding State}" StopAt="{Binding StopAt}" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding Verdict}" />
                <TextBlock Grid.Column="2" Text="{Binding Verdict}" Style="{StaticResource VerdictText}"
                           Margin="20,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Metric}" Foreground="{DynamicResource InkSoft}"
                           FontFamily="{StaticResource DisplayNarrow}" Typography.NumeralAlignment="Tabular"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ServiceBlock" DataType="{x:Type local:ServiceVm}">
            <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource RowToggle}"
                              AutomationProperties.Name="{Binding Title}"
                              AutomationProperties.HelpText="{Binding Summary}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource NameColumn}" />
                            <ColumnDefinition Width="{StaticResource TrailColumn}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource MetricColumn}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="21"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource SummaryText}"
                                   Margin="20,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="Chevron" Grid.Column="3" Text="&#xE70D;" FontFamily="{StaticResource Icons}"
                                   FontSize="12" Foreground="{DynamicResource InkSoft}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                </ToggleButton>

                <ItemsControl ItemsSource="{Binding Targets}" ItemTemplate="{StaticResource TargetRow}" Focusable="False" />

                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}" Margin="0,10,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource NameColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding PlanHeading}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding HasPlanHeading, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding PlanItems}" Focusable="False" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Rectangle Width="10" Height="2.5" Fill="{DynamicResource Pine}" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Technical}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource InkSoft}" FontSize="12"
                                                 TextWrapping="Wrap" Padding="0" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,14,0,14" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <!-- своя рамка: заголовок Тропы вместо системного, края окна по-прежнему тянутся -->
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" Background="{DynamicResource Paper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======== заголовок: метка, вкладки, состояние защиты, кнопки окна ======== -->
            <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="24,0,34,0" VerticalAlignment="Center">
                        <Border BorderBrush="{DynamicResource Ink}" BorderThickness="1" CornerRadius="1.5" Width="13" Height="17">
                            <UniformGrid Rows="3">
                                <Rectangle Fill="White" />
                                <Rectangle x:Name="BrandStripe" Fill="{DynamicResource Signal}" />
                                <Rectangle Fill="White" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Тропа" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold"
                                   Margin="10,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize" ToolTip="Свернуть" />
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="ToggleMaximize" ToolTip="Развернуть" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseClicked" ToolTip="Закрыть" />
                    </StackPanel>

                    <!-- плашка: состояние защиты видно с любой страницы -->
                    <Border DockPanel.Dock="Right" x:Name="PillBorder" CornerRadius="11" Padding="11,3,13,4" Margin="0,0,18,0"
                            VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Paper}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Fog}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pill}" Value="On"><Setter Property="Fill" Value="{DynamicResource Pine}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Pill}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Signal}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Pill}" Value="Busy"><Setter Property="Fill" Value="{DynamicResource Amber}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding PillText}" FontFamily="{StaticResource DisplayNarrow}" FontSize="13"
                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <RadioButton Style="{StaticResource NavTab}" Content="Обзор" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Overview}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Overview" />
                        <RadioButton Style="{StaticResource NavTab}" Content="Приложения" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Apps}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Apps" />
                        <RadioButton Style="{StaticResource NavTab}" Content="Telegram" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Telegram}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Telegram" />
                        <RadioButton Style="{StaticResource NavTab}" Content="Журнал" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Log}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Log" />
                        <RadioButton Style="{StaticResource NavTab}" Content="Настройки" GroupName="Nav"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ======== полоса уведомлений: новая версия или «в прошлый раз Тропа упала» ======== -->
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                    Padding="48,10" Visibility="{Binding HasBanner, Converter={StaticResource Visible}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Что нового" Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" Margin="0,0,8,0"
                                Command="{Binding ReleaseNotesCommand}" Visibility="{Binding BannerIsUpdate, Converter={StaticResource Visible}}" />
                        <Button Content="Позже" Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" Margin="0,0,8,0"
                                Command="{Binding BannerLaterCommand}" />
                        <Button Content="{Binding BannerAction}" Style="{StaticResource PrimaryButton}" Padding="16,6" FontSize="13"
                                Command="{Binding BannerPrimaryCommand}" />
                    </StackPanel>
                    <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource Pine}" Margin="0,2,12,2" />
                    <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" Margin="0,0,16,0" />
                </DockPanel>
            </Border>

            <!-- ======== Обзор ======== -->
            <Grid Grid.Row="2" Margin="48,26,48,26" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Overview}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource Display}" FontSize="36" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Subline}" FontSize="15.5" Foreground="{DynamicResource InkSoft}"
                               TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" LineHeight="23" />

                    <!-- «Почему не открывается?»: любой сайт по тем же этапам, вердикт и обход одной кнопкой -->
                    <DockPanel Margin="0,20,0,0" Width="760" HorizontalAlignment="Left">
                        <Button DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource QuietButton}"
                                Command="{Binding CheckSiteCommand}" Margin="10,0,0,0" Padding="20,8" />
                        <Grid>
                            <TextBox x:Name="SiteBox" Text="{Binding SiteInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" FontSize="15" Padding="10,6"
                                     AutomationProperties.Name="Адрес сайта для проверки">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CheckSiteCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Почему не открывается? Вставьте адрес сайта, например rutracker.org"
                                       Foreground="{DynamicResource Fog}" FontSize="15" Margin="17,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SiteInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <Border Margin="0,12,0,0" Padding="16,12,16,14" CornerRadius="4" MaxWidth="1100" HorizontalAlignment="Left"
                            Background="{DynamicResource Surface}"
                            Visibility="{Binding HasSiteResult, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource NameColumn}" />
                                    <ColumnDefinition Width="{StaticResource TrailColumn}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SiteRow.Host}" FontFamily="{StaticResource Display}" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                <local:TrailView Grid.Column="1" State="{Binding SiteRow.State}" StopAt="{Binding SiteRow.StopAt}"
                                                 VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SiteHeadline}" FontFamily="{StaticResource Display}" FontSize="15"
                                           Margin="20,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="3" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10"
                                        Style="{StaticResource QuietButton}" Padding="9,7" ToolTip="Закрыть"
                                        Command="{Binding CloseSiteCommand}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding SiteExplain}" Style="{StaticResource Soft}" Margin="0,10,0,0" MaxWidth="760"
                                       HorizontalAlignment="Left" />
                            <Button Content="{Binding SiteBypassLabel}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding BypassSiteCommand}" Margin="0,12,0,0"
                                    Visibility="{Binding SiteCanBypass, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Подписи этапов стоят ровно над отметками троп -->
                <Grid Grid.Row="1" Margin="0,28,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource NameColumn}" />
                        <ColumnDefinition Width="{StaticResource TrailColumn}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <UniformGrid Grid.Column="1" Columns="5" TextElement.Foreground="{DynamicResource InkSoft}"
                                 TextElement.FontFamily="{StaticResource DisplayNarrow}" TextElement.FontSize="12.5">
                        <TextBlock Text="DNS" HorizontalAlignment="Center" ToolTip="Поиск адреса сайта" />
                        <TextBlock Text="TCP" HorizontalAlignment="Center" ToolTip="Подключение к серверу" />
                        <TextBlock Text="TLS" HorizontalAlignment="Center" ToolTip="Защищённое соединение: здесь DPI видит имя сайта" />
                        <TextBlock Text="HTTP" HorizontalAlignment="Center" ToolTip="Запрос и ответ сервера" />
                        <TextBlock Text="передача" HorizontalAlignment="Center" ToolTip="Загрузка данных" />
                    </UniformGrid>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="10,0" Margin="-10,0">
                    <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ServiceBlock}" Focusable="False" />
                </ScrollViewer>

                <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="True">
                    <!-- без службы главная кнопка «Проверить», со службой — «Подобрать обход» -->
                    <Button DockPanel.Dock="Right" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Visibility="{Binding CheckIsPrimary, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}"
                            Style="{StaticResource QuietButton}"
                            Visibility="{Binding TuneVisible, Converter={StaticResource Visible}}" />
                    <!-- «Подобрать обход» зелёная, только когда что-то сломано; когда всё работает, она спокойная -->
                    <Button DockPanel.Dock="Right" Content="Подобрать обход" Command="{Binding TuneCommand}" Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Visibility="{Binding TuneIsPrimary, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="Подобрать обход" Command="{Binding TuneCommand}" Margin="0,0,10,0"
                            Style="{StaticResource QuietButton}"
                            Visibility="{Binding TuneIsSecondary, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="{Binding ProtectLabel}" Command="{Binding ProtectCommand}" Margin="0,0,10,0"
                            Style="{StaticResource QuietButton}"
                            Visibility="{Binding ProtectVisible, Converter={StaticResource Visible}}" />
                    <Button DockPanel.Dock="Right" Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Margin="0,0,10,0"
                            Style="{StaticResource QuietButton}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CheckedAt}" Foreground="{DynamicResource InkSoft}" FontSize="12.5" />
                        <TextBlock Text="{Binding ModeNote}" Foreground="{DynamicResource InkSoft}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,2,16,0"
                                   Visibility="{Binding HasModeNote, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- ======== Приложения ======== -->
            <Grid Grid.Row="2" Margin="48,26,48,26" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Apps}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,22">
                    <TextBlock Text="Приложения" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Soft}" FontSize="15" MaxWidth="700" HorizontalAlignment="Left" Margin="0,6,0,0"
                               Text="Тропа обходит блокировки для этих сервисов. Если игра или сайт работает плохо, добавьте его: Тропа подберёт стратегию и будет держать её." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding AppRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AppRowVm}">
                                <StackPanel>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Content="Удалить" Style="{StaticResource QuietButton}" Padding="14,6"
                                                FontSize="13" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Key}"
                                                Visibility="{Binding IsUser, Converter={StaticResource Visible}}" />
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource SummaryText}" Margin="16,3,0,0" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource InkSoft}" FontSize="13" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,12,0,12" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- правая колонка: заготовки или форма -->
                <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <StackPanel Visibility="{Binding FormVisible, Converter={StaticResource IsVisible}, ConverterParameter=False}">
                            <TextBlock Text="Добавить" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Soft}" Margin="0,0,0,14"
                                       Text="Начните с заготовки: домены уже собраны, их можно поправить." />
                            <ItemsControl ItemsSource="{Binding Templates}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AppTemplate}">
                                        <Button Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                                                Padding="16,11" FontSize="15"
                                                Command="{Binding DataContext.UseTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Name}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding FormVisible, Converter={StaticResource Visible}}">
                            <TextBlock Text="Новое приложение" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FormNote}" Style="{StaticResource Soft}" />

                            <TextBlock Text="Название" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />

                            <TextBlock Text="Домены, по одному в строке (поддомены обходятся сами)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FormDomains, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     AcceptsReturn="True" Height="118" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

                            <TextBlock Text="Хосты для проверки (если пусто, первые домены)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FormCheck, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Игровые UDP-порты" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding FormUdp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Игровые TCP-порты" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding FormTcp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Soft}" FontSize="12.5" Margin="0,6,0,0"
                                       Text="Например 7777 или 27000-27100. Обход на этих портах действует для любого адреса, поэтому не указывайте лишнего." />

                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding FormAlways}" Margin="0,16,0,0">
                                <TextBlock TextWrapping="Wrap" Text="Обходить всегда, даже если проверка проходит (для игр, которые тормозят, а не отваливаются)" />
                            </ToggleButton>

                            <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource Signal}" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding HasFormError, Converter={StaticResource Visible}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Добавить и подобрать" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitAppCommand}" />
                                <Button Content="Отмена" Style="{StaticResource QuietButton}" Command="{Binding CancelFormCommand}" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======== Telegram: локальный прокси службы ======== -->
            <Grid Grid.Row="2" Margin="48,26,48,26" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Telegram}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,26">
                    <TextBlock Text="Telegram" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Soft}" FontSize="15" MaxWidth="720" HorizontalAlignment="Left" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Тропа держит для Telegram локальный прокси: трафик уходит через WebSocket веб-версии Telegram, который режут реже, а если и его нет — через Cloudflare. Работает внутри службы, окно можно закрыть." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,4,14,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Fog}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TgHealth}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Pine}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding TgHealth}" Value="Partial"><Setter Property="Fill" Value="{DynamicResource Amber}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding TgHealth}" Value="Blocked"><Setter Property="Fill" Value="{DynamicResource Signal}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding TgHeadline}" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding TgSubline}" FontSize="15.5" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource InkSoft}" Margin="28,0,0,22" />

                        <WrapPanel Margin="28,0,0,18">
                            <Button Content="{Binding TgPrimaryLabel}" Command="{Binding TgPrimaryCommand}" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,10,10" />
                            <Button Content="Проверить дата-центры" Command="{Binding TgCheckCommand}" Style="{StaticResource QuietButton}"
                                    Margin="0,0,10,10" Visibility="{Binding TgOn, Converter={StaticResource Visible}}" />
                            <Button Content="Скопировать ссылку" Command="{Binding TgCopyCommand}" Style="{StaticResource QuietButton}"
                                    Margin="0,0,10,10" Visibility="{Binding TgOn, Converter={StaticResource Visible}}" />
                        </WrapPanel>

                        <Border Margin="28,0,0,18" Padding="16,12" CornerRadius="10" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Left" MaxWidth="640"
                                Visibility="{Binding HasTgRival, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Закрыть его" Command="{Binding TgCloseRivalCommand}"
                                        Style="{StaticResource QuietButton}" Padding="14,6" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <TextBlock Text="{Binding TgRival}" TextWrapping="Wrap" FontSize="13.5" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <StackPanel Margin="28,6,0,0" Visibility="{Binding TgOn, Converter={StaticResource Visible}}">
                            <TextBlock Text="Как это устроено" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Run Text="Прокси слушает только этот компьютер: " /><Run Text="{Binding TgAddress, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" /><Run Text=". Telegram шифрует всё сам, Тропа лишь перекладывает его пакеты в WebSocket и не видит переписку." />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Soft}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,18"
                                       Text="Телефон так не подключить: прокси открыт только для этого компьютера. Чтобы Telegram снова ходил напрямую, отключите прокси в его настройках." />
                            <Button Content="Выключить прокси" Command="{Binding TgOffCommand}" Style="{StaticResource QuietButton}"
                                    Foreground="{DynamicResource Signal}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- правая колонка: дата-центры и счётчики -->
                <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="Дата-центры" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding DcRows}" Focusable="False" Margin="0,0,0,22">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DcRowVm}">
                                    <StackPanel>
                                        <DockPanel Margin="0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource SummaryText}" FontSize="14" />
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Width="52" />
                                            <TextBlock Text="{Binding Place}" Foreground="{DynamicResource InkSoft}" FontSize="13.5" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Rectangle Height="1" Fill="{DynamicResource Line}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding HasTgStats, Converter={StaticResource Visible}}">
                            <TextBlock Text="Что идёт через прокси" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding TgStats}" Style="{StaticResource Soft}" LineHeight="22" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Soft}" FontSize="12.5" Margin="0,22,0,0" TextWrapping="Wrap"
                                   Text="Порт tg-ws-proxy от Flowseal (MIT), переписан на C# и работает в службе Тропы без Python." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======== Журнал ======== -->
            <Grid Grid.Row="2" Margin="48,26,48,26" Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Log}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="Открыть журнал службы" Style="{StaticResource QuietButton}"
                            Command="{Binding OpenServiceLogCommand}" VerticalAlignment="Top" />
                    <Button DockPanel.Dock="Right" Content="Сообщить о проблеме" Style="{StaticResource QuietButton}"
                            Command="{Binding ReportProblemCommand}" VerticalAlignment="Top" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Журнал" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Soft}" FontSize="15" Margin="0,6,0,0"
                                   Text="Что Тропа делала с момента открытия окна: попытки подбора, перезапуски, обновления." />
                    </StackPanel>
                </DockPanel>
                <TextBlock Grid.Row="1" Style="{StaticResource Soft}" Text="Пока тихо. События появятся, когда служба что-нибудь сделает."
                           Visibility="{Binding LogLines.Count, Converter={StaticResource WhenEmpty}}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding LogLines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LogLine}">
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="70" Foreground="{DynamicResource InkSoft}"
                                               FontFamily="{StaticResource DisplayNarrow}" Typography.NumeralAlignment="Tabular" />
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" Padding="0" FontSize="14">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Signal}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ======== Настройки ======== -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding Page, Converter={StaticResource IsVisible}, ConverterParameter=Settings}">
                <StackPanel Margin="48,26,48,26" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" Margin="0,0,0,24" />

                    <TextBlock Text="Защита" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Soft}" Text="{Binding ModeNote}" Margin="0,0,0,12"
                               Visibility="{Binding HasModeNote, Converter={StaticResource Visible}}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding ProtectLabel}" Command="{Binding ProtectCommand}" Style="{StaticResource QuietButton}"
                                Visibility="{Binding ProtectVisible, Converter={StaticResource Visible}}" Margin="0,0,10,0" />
                        <Button Content="Подобрать обход заново" Command="{Binding TuneCommand}" Style="{StaticResource QuietButton}" />
                    </StackPanel>
                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,26,0,24" />

                    <TextBlock Text="Обновления Тропы" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="15" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding AppUpdateText}" Style="{StaticResource Soft}" Margin="0,0,0,14" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CheckAppUpdates}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Проверять новые версии Тропы на github.com/xckrt/Tropa и предлагать обновиться (сама Тропа без спроса не обновляется)" />
                    </ToggleButton>
                    <Button Content="Проверить сейчас" Command="{Binding CheckAppUpdateCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,26,0,24" />

                    <TextBlock Text="Обновления zapret" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding EngineText}" FontSize="15" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Soft}" Margin="0,0,0,14" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding HasService}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Обновлять автоматически: раз в сутки Тропа ищет новый релиз bol-van/zapret, сверяет хеши и переходит на него, а если он не запустится, возвращается к прежнему" />
                    </ToggleButton>
                    <Button Content="Проверить сейчас" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,26,0,24" />

                    <TextBlock Text="Окно" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Тема" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <RadioButton Style="{StaticResource Segment}" Content="Как в Windows" GroupName="Theme"
                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=System}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="System" />
                        <RadioButton Style="{StaticResource Segment}" Content="Светлая" GroupName="Theme"
                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Light}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                        <RadioButton Style="{StaticResource Segment}" Content="Тёмная" GroupName="Theme"
                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Dark}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    </StackPanel>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Autostart}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap" Text="Запускать Тропу вместе с Windows (сразу в трей)" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Notify}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap" Text="Уведомлять, когда служба сама что-то сделала: подобрала заново, обновила zapret, не смогла включить защиту" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}">
                        <TextBlock TextWrapping="Wrap" Text="Закрывать в трей: защиту держит служба, окно можно открыть значком у часов" />
                    </ToggleButton>
                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,26,0,24" />

                    <TextBlock Text="О программе" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding BuildText}" Style="{StaticResource Soft}" />
                    <TextBlock Style="{StaticResource Soft}" Margin="0,4,0,14"
                               Text="Движок: zapret от bol-van, стратегии и шаблоны Flowseal/zapret-discord-youtube (MIT)." />
                    <Button Content="Сообщить о проблеме" Command="{Binding ReportProblemCommand}" Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Soft}" FontSize="12.5" Margin="0,0,0,14"
                               Text="Откроется черновик issue на GitHub с версиями и журналами. Вы увидите весь текст до отправки; без вашего нажатия Тропа ничего никуда не шлёт." />
                    <Button Content="Удалить службу Тропы" Command="{Binding UninstallServiceCommand}" Style="{StaticResource QuietButton}"
                            Foreground="{DynamicResource Signal}" HorizontalAlignment="Left"
                            Visibility="{Binding HasService, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
