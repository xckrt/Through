<Application x:Class="Tropa.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Палитра «топокарта»: фон как бумага карты, путь сосной, обрыв краской туристической метки -->
        <Color x:Key="PaperColor">#EEF1EC</Color>
        <Color x:Key="SurfaceColor">#E3E8E1</Color>
        <Color x:Key="InkColor">#1C2A2E</Color>
        <Color x:Key="InkSoftColor">#56645F</Color>
        <Color x:Key="LineColor">#C9D2CB</Color>
        <Color x:Key="FogColor">#9AA59F</Color>
        <Color x:Key="PineColor">#2E7D5B</Color>
        <Color x:Key="PineDarkColor">#23634A</Color>
        <Color x:Key="SignalColor">#C8322B</Color>
        <Color x:Key="AmberColor">#B7791F</Color>

        <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}" />
        <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="Fog" Color="{StaticResource FogColor}" />
        <SolidColorBrush x:Key="Pine" Color="{StaticResource PineColor}" />
        <SolidColorBrush x:Key="PineDark" Color="{StaticResource PineDarkColor}" />
        <SolidColorBrush x:Key="Signal" Color="{StaticResource SignalColor}" />
        <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />

        <!-- Bahnschrift: шрифт дорожных указателей, есть в каждой Windows 10/11 -->
        <FontFamily x:Key="Display">Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayNarrow">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Ширины колонок общие для заголовка этапов, строк сервисов и строк целей -->
        <GridLength x:Key="NameColumn">200</GridLength>
        <GridLength x:Key="TrailColumn">300</GridLength>
        <GridLength x:Key="MetricColumn">96</GridLength>

        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" Stroke="{StaticResource Ink}" StrokeThickness="2" RadiusX="4" RadiusY="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Pine}" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PineDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Line}" />
                                <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Fog}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка сервиса целиком кликабельна и раскрывает подробности -->
        <Style x:Key="RowToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="10,8" Margin="-10,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкая полоса прокрутки в цвет линий, а не серая системная -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="{StaticResource Line}" CornerRadius="3" Margin="1,0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{StaticResource Fog}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{StaticResource InkSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="Visible" />
    </Application.Resources>
</Application>
