<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tropa.Core\Tropa.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Tropa</AssemblyName>
    <RootNamespace>Tropa.Tray</RootNamespace>
  </PropertyGroup>

  <!-- каталоги общие с CLI: правятся в одном месте -->
  <ItemGroup>
    <None Include="..\Tropa.Cli\targets.json" Link="targets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Tropa.Cli\presets.json" Link="presets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
