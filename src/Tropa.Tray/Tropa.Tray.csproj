<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tropa.Core\Tropa.Core.csproj" />
    <!-- служба лежит рядом с окном: окно само ставит её одной кнопкой -->
    <ProjectReference Include="..\Tropa.Service\Tropa.Service.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- только ради значка в трее (NotifyIcon); глобальные using WinForms убраны, чтобы не путались с WPF -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Tropa</AssemblyName>
    <RootNamespace>Tropa.Tray</RootNamespace>
    <!-- знак Тропы: метка «бело-красно-белая» на табличке и пунктир тропы; рисует IconArt.cs -->
    <ApplicationIcon>tropa.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="tropa.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- каталоги общие с CLI: правятся в одном месте -->
  <ItemGroup>
    <None Include="..\Tropa.Cli\targets.json" Link="targets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Tropa.Cli\presets.json" Link="presets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Tropa.Cli\engine.json" Link="engine.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- английский интерфейс: ключ — русская строка из кода, значение — перевод (Loc) -->
    <EmbeddedResource Include="en.json" LogicalName="Tropa.Tray.en.json" />
  </ItemGroup>
</Project>
