<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- «Ночная карта»: не чёрный, а глубокий сине-зелёный; тропа светлее, чтобы читалась в темноте -->
    <SolidColorBrush x:Key="Paper" Color="#131C1E" />
    <SolidColorBrush x:Key="Surface" Color="#1D292C" />
    <SolidColorBrush x:Key="Field" Color="#182326" />
    <SolidColorBrush x:Key="Chrome" Color="#0F1719" />
    <SolidColorBrush x:Key="Ink" Color="#E3EAE5" />
    <SolidColorBrush x:Key="InkSoft" Color="#94A49E" />
    <SolidColorBrush x:Key="Line" Color="#2B3B3E" />
    <SolidColorBrush x:Key="Fog" Color="#5B6B65" />
    <SolidColorBrush x:Key="Pine" Color="#52B788" />
    <SolidColorBrush x:Key="PineDark" Color="#46A177" />
    <SolidColorBrush x:Key="Signal" Color="#EF6A55" />
    <SolidColorBrush x:Key="Amber" Color="#E3A53C" />
    <SolidColorBrush x:Key="OnAccent" Color="#0D1A15" />
    <SolidColorBrush x:Key="Knob" Color="#E3EAE5" />
</ResourceDictionary>
