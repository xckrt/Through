{
  // services: что проверяем. Контрольные хосты: если лежат все, значит нет сети, а не блокировка.
  "services": {
    "control": [
      { "name": "ya.ru", "host": "ya.ru", "isControl": true },
      { "name": "vk.com", "host": "vk.com", "isControl": true }
    ],
    "youtube": [
      { "name": "youtube web", "host": "www.youtube.com", "path": "/generate_204" },
      { "name": "youtube video", "host": "redirector.googlevideo.com" },
      // крупная передача с CDN YouTube (maxres-обложка, ~100 КБ): ловит «заморозку 16 КБ» (ТСПУ), которую
      // короткие проверки не видят. Без неё ни подбор, ни сторож не замечают, что видео морозится, — как
      // было с Discord. Рестарт winws глобален, так что лечит и googlevideo. dQw4w9WgXcQ — самый стабильный
      // ролик, maxres-обложка есть всегда
      { "name": "youtube thumb", "host": "i.ytimg.com", "path": "/vi/dQw4w9WgXcQ/maxresdefault.jpg", "minBytes": 49152 }
    ],
    "discord": [
      { "name": "discord api", "host": "discord.com", "path": "/api/v9/gateway" },
      // крупная передача с discord.com (~70 КБ): ловит «заморозку 16 КБ» (ТСПУ), которую короткие запросы не
      // видят. Обязательная: настольный клиент на загрузке тянет с discord.com большие ответы (READY по REST,
      // эксперименты, science) и упирается ровно в неё. Без этой цели подбор берёт стратегию, которая чинит
      // только TLS-рукопожатие (напр. multisplit-sniext), короткие проверки проходят — а клиент висит на экране
      // загрузки. С обязательной целью Тюнер перебирает стратегии, лечащие заморозку (treats TransferStalled)
      { "name": "discord app", "host": "discord.com", "path": "/app", "minBytes": 65536 },
      // живое соединение, как у клиента: websocket и первое сообщение (HELLO). TLS и короткий HTTP
      // проходили, а клиент висел на экране загрузки — вот это и проверяем
      { "name": "discord gateway", "host": "gateway.discord.gg", "path": "/?v=10&encoding=json", "webSocket": true, "minBytes": 1 },
      { "name": "discord cdn", "host": "cdn.discordapp.com" },
      // с этого хоста приложение Discord качает обновления при старте: без него висит «Starting…»
      // второстепенная: на живой сети через 5–10 минут начинала падать, хотя Discord целиком работал
      { "name": "discord updates", "host": "dl.discordapp.net", "optional": true, "role": "обновления клиента" },
      // голос: UDP IP Discovery на серверы ближайших регионов, как при входе в голосовой канал
      { "name": "discord voice", "host": "latency.discord.media", "path": "/rtc", "voice": true, "optional": true, "role": "голос" }
    ],
    // Канарейка «заморозки 16 КБ»: качаем 64 КБ с Cloudflare.
    "cloudflare": [
      { "name": "cf 64 KB", "host": "speed.cloudflare.com", "path": "/__down?bytes=65536", "minBytes": 65536 }
    ]
  },

  // domains: что обходим. Приложение ходит на десятки хостов, а проверяем мы несколько;
  // winws обходит домен вместе со всеми поддоменами. Списки сверены с lists/ из
  // Flowseal/zapret-discord-youtube (MIT).
  "domains": {
    "youtube": [
      "youtube.com", "youtu.be", "youtube-nocookie.com", "youtubekids.com",
      "googlevideo.com", "ytimg.com", "ggpht.com",
      "youtubei.googleapis.com", "youtube.googleapis.com", "youtubeembeddedplayer.googleapis.com",
      "jnn-pa.googleapis.com", "yt3.googleusercontent.com",
      "wide-youtube.l.google.com", "youtube-ui.l.google.com", "ytimg.l.google.com", "yt-video-upload.l.google.com"
    ],
    "discord": [
      "discord.com", "discord.gg", "discord.app", "discord.co", "discord.dev", "discord.new", "discord.gift",
      "discord.gifts", "discord.media", "discord.store", "discord.status", "discord.design", "dis.gd",
      "discordapp.com", "discordapp.net", "discordcdn.com", "discordstatus.com", "discordsays.com",
      "discordsez.com", "discord-activities.com", "discordactivities.com", "discordpartygames.com",
      "discordmerch.com", "discord-attachments-uploads-prd.storage.googleapis.com"
    ]
  },

  // ports: дополнительные TCP-порты для обхода, если сервису нужны не только 443 (медиа Discord идёт
  // отдельным профилем discord-media в presets.json).
  "ports": {}
}
