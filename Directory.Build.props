<Project>
  <!-- одна версия на все проекты: её показывает окно, по ней проверяются обновления, ею помечен установщик -->
  <PropertyGroup>
    <Version>1.2.8</Version>
    <Product>Сквозь</Product>
    <Company>Through</Company>
    <Copyright>MIT, github.com/xckrt/Through</Copyright>
    <RepositoryUrl>https://github.com/xckrt/Through</RepositoryUrl>
    <!-- без хвоста +commit в версии: её сравнивают с тегами релизов -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
